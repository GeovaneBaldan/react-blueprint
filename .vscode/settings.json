{
  "files.exclude": {
    "out": false,
    "dist": false
  },
  "search.exclude": {
    "out": true,
    "dist": true
  },

  "js/ts.tsc.autoDetect": "off",

  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },

  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  "[html]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
